# Copie para .env e preencha no seu computador. Não envie as chaves no chat.
# Nenhuma chamada externa é feita pela configuração ou pelos testes offline.
APP_MODE=offline
APP_TIMEZONE=America/Sao_Paulo
BASE_CURRENCY=BRL

# Modelo escolhido pelo proprietário; não alterar sem autorização.
OPENAI_MODEL=gpt-6-luna
OPENAI_API_KEY=

# Usar chave gerada pelo proprietário com permissão de transcrição.
ELEVENLABS_API_KEY=
ELEVENLABS_STT_MODEL=scribe_v2

# Bot próprio criado no BotFather. ID do proprietário é numérico, não @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_USER_ID=

# Banco local automático; PostgreSQL é usado no Compose e em produção.
# DATABASE_URL=postgresql+psycopg://our_finances:SENHA_LOCAL@127.0.0.1:55439/our_finances
REPORT_DIRECTORY=exports

# Saída falada fica desabilitada até escolher voz e modelo ElevenLabs.
ELEVENLABS_TTS_MODEL=
ELEVENLABS_VOICE_ID=

# Somente para a futura operação por webhook HTTPS.
TELEGRAM_WEBHOOK_SECRET=

# Credenciais Google, Microsoft e hospedagem serão configuradas nas etapas próprias.
# Não colocar senha de conta, código de login ou dados financeiros neste arquivo.
